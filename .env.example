# Copy to backend/.env — never commit the real file.

# FreeLLMAPI (https://github.com/tashfeenahmed/freellmapi) — unified key from its Keys page
FREELLM_BASE_URL=http://localhost:3001/v1
FREELLM_API_KEY=freellmapi-xxxxxxxx
# Optional per-role model overrides (default: auto:smart / auto:fast / auto)
# RUNE_MODEL_REASON=auto:smart
# RUNE_MODEL_FAST=auto:fast
# RUNE_MODEL_CREATIVE=auto
# RUNE_MODEL_VISION=<a vision-capable model id from the FreeLLMAPI catalog>

# Claude via the Claude Code CLI, logged into your Claude plan (no API credits)
RUNE_USE_CLAUDE=1
CLAUDE_MODEL=sonnet
CLAUDE_MAX_TOKENS=2048
CLAUDE_DAILY_TOKENS=150000
RUNE_CLAUDE_FOR=shlok,auditor,core

# Ad background images from your ChatGPT plan via the Codex CLI (npm i -g @openai/codex; codex login)
RUNE_IMAGE_CODEX=0

# Local fallback (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:latest

# Research APIs
TAVILY_API_KEY=
JINA_API_KEY=

# Meta Marketing API (sandbox ad account for development)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=
META_PIXEL_ID=
# optional: Instagram engagers for retargeting, and catalog ads
META_IG_ACCOUNT_ID=
META_BUSINESS_ID=
META_CATALOG_ID=
META_API_VERSION=v23.0
# 1 = real campaign/ad sets, simulated creatives/ads (until the app has pages_manage_ads)
META_DRY_RUN_ADS=1
META_DRY_RUN=1
# simulated = monitor/optimise on simulated insights even with real launches (sandbox accounts never deliver)
RUNE_INSIGHTS=simulated

# Local
RUNE_DB=rune.db
RUNE_AUTO_APPROVE=0
# 1 = sign-in, roles, client portal (first visit to /login creates the owner); RUNE_SECRET signs share links
RUNE_AUTH=0
RUNE_SECRET=
